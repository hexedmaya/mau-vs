{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "mau",
  "scopeName": "text.html.mau",
  "patterns": [
    { "include": "#comment" },
    { "include": "#script" },
    { "include": "#style" },
    { "include": "#block" },
    { "include": "#html-directive" },
    { "include": "#expression" },
    { "include": "#tag" }
  ],
  "repository": {
    "comment": {
      "name": "comment.block.html",
      "begin": "<!--",
      "end": "-->",
      "beginCaptures": { "0": { "name": "punctuation.definition.comment.html" } },
      "endCaptures": { "0": { "name": "punctuation.definition.comment.html" } }
    },

    "script": {
      "begin": "(<)(script)\\b([^>]*)(>)",
      "end": "(</)(script)(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.html" },
        "3": { "patterns": [{ "include": "#attribute" }] },
        "4": { "name": "punctuation.definition.tag.end.html" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.html" },
        "3": { "name": "punctuation.definition.tag.end.html" }
      },
      "contentName": "meta.embedded.block.javascript",
      "patterns": [{ "include": "source.js" }]
    },

    "style": {
      "begin": "(<)(style)\\b([^>]*)(>)",
      "end": "(</)(style)(>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.html" },
        "3": { "patterns": [{ "include": "#attribute" }] },
        "4": { "name": "punctuation.definition.tag.end.html" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.html" },
        "3": { "name": "punctuation.definition.tag.end.html" }
      },
      "contentName": "meta.embedded.block.css",
      "patterns": [{ "include": "source.css" }]
    },

    "block": {
      "patterns": [
        {
          "comment": "{#if cond} {#each list as item (key)}",
          "begin": "(\\{)\\s*(#)(if|each)\\b",
          "end": "(\\})",
          "beginCaptures": {
            "1": { "name": "punctuation.section.embedded.begin.mau" },
            "2": { "name": "keyword.control.mau" },
            "3": { "name": "keyword.control.mau" }
          },
          "endCaptures": { "1": { "name": "punctuation.section.embedded.end.mau" } },
          "contentName": "meta.embedded.expression.mau",
          "patterns": [
            { "match": "\\bas\\b", "name": "keyword.control.mau" },
            { "include": "source.js#expression" }
          ]
        },
        {
          "comment": "{:else if cond} {:else}",
          "begin": "(\\{)\\s*(:)(else)(?:\\s+(if)\\b)?",
          "end": "(\\})",
          "beginCaptures": {
            "1": { "name": "punctuation.section.embedded.begin.mau" },
            "2": { "name": "keyword.control.mau" },
            "3": { "name": "keyword.control.mau" },
            "4": { "name": "keyword.control.mau" }
          },
          "endCaptures": { "1": { "name": "punctuation.section.embedded.end.mau" } },
          "contentName": "meta.embedded.expression.mau",
          "patterns": [{ "include": "source.js#expression" }]
        },
        {
          "match": "(\\{)\\s*(/)(if|each)\\s*(\\})",
          "captures": {
            "1": { "name": "punctuation.section.embedded.begin.mau" },
            "2": { "name": "keyword.control.mau" },
            "3": { "name": "keyword.control.mau" },
            "4": { "name": "punctuation.section.embedded.end.mau" }
          }
        }
      ]
    },

    "html-directive": {
      "begin": "(\\{)\\s*(@)(html)\\b",
      "end": "(\\})",
      "beginCaptures": {
        "1": { "name": "punctuation.section.embedded.begin.mau" },
        "2": { "name": "keyword.control.mau" },
        "3": { "name": "keyword.control.mau" }
      },
      "endCaptures": { "1": { "name": "punctuation.section.embedded.end.mau" } },
      "contentName": "meta.embedded.expression.mau",
      "patterns": [{ "include": "source.js#expression" }]
    },

    "expression": {
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": { "0": { "name": "punctuation.section.embedded.begin.mau" } },
      "endCaptures": { "0": { "name": "punctuation.section.embedded.end.mau" } },
      "contentName": "meta.embedded.expression.mau",
      "patterns": [{ "include": "source.js#expression" }]
    },

    "tag": {
      "patterns": [
        {
          "comment": "Component: <Item ...>",
          "begin": "(</?)([A-Z][\\w.]*)",
          "end": "(/?>)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.begin.html" },
            "2": { "name": "support.class.component.mau" }
          },
          "endCaptures": { "1": { "name": "punctuation.definition.tag.end.html" } },
          "patterns": [{ "include": "#attribute" }]
        },
        {
          "begin": "(</?)([a-z][\\w:.-]*)",
          "end": "(/?>)",
          "beginCaptures": {
            "1": { "name": "punctuation.definition.tag.begin.html" },
            "2": { "name": "entity.name.tag.html" }
          },
          "endCaptures": { "1": { "name": "punctuation.definition.tag.end.html" } },
          "patterns": [{ "include": "#attribute" }]
        }
      ]
    },

    "attribute": {
      "patterns": [
        {
          "comment": "on:click bind:value",
          "match": "\\b(on|bind)(:)([\\w-]+)",
          "captures": {
            "1": { "name": "keyword.control.mau" },
            "2": { "name": "punctuation.separator.namespace.mau" },
            "3": { "name": "entity.other.attribute-name.mau" }
          }
        },
        { "match": "[^\\s=/>{}\"']+", "name": "entity.other.attribute-name.html" },
        { "match": "=", "name": "punctuation.separator.key-value.html" },
        { "include": "#expression" },
        {
          "name": "string.quoted.double.html",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.html" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.html" } },
          "patterns": [{ "include": "#expression" }]
        },
        {
          "name": "string.quoted.single.html",
          "begin": "'",
          "end": "'",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.html" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.html" } },
          "patterns": [{ "include": "#expression" }]
        }
      ]
    }
  }
}
