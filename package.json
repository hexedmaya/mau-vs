{
  "name": "mau",
  "displayName": "mau",
  "description": "Syntax highlighting for .mau single-file components",
  "version": "0.1.1",
  "publisher": "hexedmaya",
  "license": "SEE LICENSE IN LICENSE",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "mau",
    "syntax highlighting",
    "frontend",
    "template"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/hexedmaya/mau-vs.git"
  },
  "homepage": "https://github.com/hexedmaya/mau-vs#readme",
  "bugs": {
    "url": "https://github.com/hexedmaya/mau-vs/issues"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  },
  "contributes": {
    "languages": [
      {
        "id": "mau",
        "aliases": [
          "mau",
          "Mau"
        ],
        "extensions": [
          ".mau"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/mau.svg",
          "dark": "./icons/mau.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "mau",
        "scopeName": "text.html.mau",
        "path": "./syntaxes/mau.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.javascript": "javascript",
          "meta.embedded.expression.mau": "javascript",
          "meta.embedded.block.css": "css"
        }
      }
    ]
  },
  "devDependencies": {
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
